# Set to true for production, false for local/dev
VITE_PROD=false

# Base API URLs
VITE_API_LOCAL=http://127.0.0.1:8000/api/v1
VITE_API_PROD=http://115.245.93.26:4216/api/v1

# Vehicle history API (Vamosys) - needs userId, groupName, vehicleId, fromDateUTC, toDateUTC
VITE_GPS_VEHICLE_HISTORY_API=https://api.vamosys.com/getVehicleHistory

# Vehicle tracking API (Vamosys) - needs providerName, fcode
VITE_GPS_VEHICLE_TRACKING_API=https://api.vamosys.com/mobile/getGrpDataForTrustedClients

# Trip summary API (Vamosys) - needs vehicleId, fromDateUTC, toDateUTC, userId, duration
VITE_GPS_TRIP_SUMMARY_API=https://gpsvtsprobend.vamosys.com/v2/getTripSummary

#day wise weighment api url
VITE_GPS_DAY_WISE_API=https://zigma.in/d2d/folders/waste_collected_summary_report/waste_collected_data_api.php


#date wise weighment api url
VITE_GPS_DATE_WISE_API=https://zigma.in/d2d/folders/waste_collected_summary_report/test_waste_collected_data_api.php

#attendance api url 
VITE_GPS_ATTENDANCE_API=http://zigfly.in/attendance-api/api/sync/recognized


# Default GPS API parameters
VITE_GPS_USER_ID=BLUEPLANET
VITE_GPS_GROUP_NAME=BLUEPLANET:VAM
VITE_GPS_PROVIDER_NAME=BLUEPLANET
VITE_GPS_FCODE=VAM
VITE_GPS_TRIP_USER_ID=NMCP2DISPOSAL


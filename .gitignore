# ==========================================================
# IWMS Frontend — .gitignore
# See README.md § Environment variables before adding secrets.
# ==========================================================

# === Dependencies ===
node_modules

# === Build output ===
dist
dist-ssr
*.local

# === Environment files (NEVER commit — see .env.example) ===
.env
.env.*
!.env.example

# === Logs ===
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# === Test / coverage output ===
coverage/

# === Per-machine and deploy scripts (not shared) ===
frontend_sync.sh
*.deb

# === Editor and OS files ===
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

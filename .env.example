# ==========================================================
# IWMS Frontend — environment template
#
# Copy this file to `.env` and fill in the real values:
#     cp .env.example .env
#
# `.env` is git-ignored and MUST stay that way.
#
# Vite only exposes variables prefixed with VITE_ to browser
# code. Anything you put here ends up in the shipped bundle
# and is readable by any visitor — so put NO real secrets in
# this file. Server-side secrets belong in the backend `.env`.
# ==========================================================

# === Which API to talk to ===
# "true"  -> use VITE_API_PROD
# "false" -> use VITE_API_LOCAL
VITE_PROD=false

VITE_API_LOCAL=http://localhost:8000/api/v1
VITE_API_PROD=https://your-production-host/api/v1

# === Vamosys GPS APIs ===
# Vehicle history — needs userId, groupName, vehicleId, fromDateUTC, toDateUTC
VITE_GPS_VEHICLE_HISTORY_API=
# Live tracking — needs providerName, fcode
VITE_GPS_VEHICLE_TRACKING_API=
# Trip summary — needs vehicleId, fromDateUTC, toDateUTC, userId, duration
VITE_GPS_TRIP_SUMMARY_API=

# Default GPS parameters sent with the calls above.
VITE_GPS_USER_ID=
VITE_GPS_GROUP_NAME=
VITE_GPS_PROVIDER_NAME=
VITE_GPS_FCODE=
VITE_GPS_TRIP_USER_ID=

# === Weighment / attendance APIs ===
# Day-wise weighment
VITE_GPS_DAY_WISE_API=
# Date-range weighment
VITE_GPS_DATE_WISE_API=
# Attendance
VITE_GPS_ATTENDANCE_API=

# === Weighbridge waste-collected summary ===
VITE_WEIGHBRIDGE_WASTE_API=
VITE_WEIGHBRIDGE_WASTE_COLLECTION_KEY=
VITE_WEIGHBRIDGE_WASTE_COLLECTION_CORS_PROXY=
